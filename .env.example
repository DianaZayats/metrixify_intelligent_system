# Application
NODE_ENV=development
APP_VERSION=0.1.0

# Server ports
BACKEND_PORT=3000
FRONTEND_PORT=5173

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=metrixify
POSTGRES_PASSWORD=metrixify
POSTGRES_DB=metrixify
POSTGRES_PORT=5432
DATABASE_URL=postgresql://metrixify:metrixify@localhost:5432/metrixify

# Redis (6380 avoids conflict with a local Redis on 6379)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Auth — server signing secret (NOT the Telegram login token users receive in chat).
# Optional for local dev: run `npm run env:setup` or `npm run app:dev` to auto-generate in .env.
# Required in production (min 32 characters).
# SESSION_SECRET=

# Backend URL (used by telegram-bot to call internal API)
BACKEND_URL=http://127.0.0.1:3000

# Frontend origin for Telegram /login links (defaults to http://localhost:FRONTEND_PORT)
# FRONTEND_URL=http://localhost:5173

# Optional: internal API key for bot → backend (defaults to SESSION_SECRET)
# INTERNAL_API_KEY=

# Telegram (required from stage 2 — create via @BotFather, see docs/telegram-bot.md)
TELEGRAM_BOT_TOKEN=

# OpenAI (required from stage 4 for voice transcription)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_SCHEMA_RESOLVER_MODEL=gpt-4o
# METRIC_SCHEMA_LLM_APPLY_MIN=0.8

# Frontend (Vite proxy) — use 127.0.0.1 on Windows to avoid IPv6 ::1 proxy errors
VITE_API_BASE_URL=http://127.0.0.1:3000
